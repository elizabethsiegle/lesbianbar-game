{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "last-ditch-bar-saga",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "LEADERBOARD", "class_name": "Leaderboard" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Leaderboard"] }],
  "observability": { "enabled": true },
}
